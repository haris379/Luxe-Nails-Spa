# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/luxe-nails

# Auth: JWT_SECRET must be a long random string (32+ chars)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# First admin account, used only by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# REQUIRED for booking: customers must verify their email with a one-time code, so SMTP must work.
# (Without SMTP_HOST and MAIL_FROM the booking page reports that verification is unavailable.)
# Local testing: use Mailpit (SMTP_HOST=localhost SMTP_PORT=1025) or an Ethereal account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional separate key for hashing one-time codes (32+ chars). Defaults to JWT_SECRET.
OTP_SECRET=
MAIL_FROM="Luxe Nails <no-reply@example.com>"
# Where contact-form messages are emailed
OWNER_EMAIL=

# Where uploaded service images are stored (default: server/uploads). On hosts with ephemeral disks,
# point this at a persistent volume, e.g. /data/uploads
UPLOAD_DIR=

